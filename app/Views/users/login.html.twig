{% extends "partials/base.html.twig" %}

{% block title %}Inloggen | Winkeltool{% endblock %}

{% block content %}
<section class="form-card narrow">
    <h1>Inloggen</h1>
    <p>Gebruik je account om de winkeltools te openen.</p>

    {% if errors is defined and errors %}
        <div class="alert error" role="alert">
            <strong>Inloggen is niet gelukt.</strong>
            <ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    <form method="post" action="/login" novalidate>
        {{ csrf_input() }}
        <label for="username">Gebruikersnaam</label>
        <input id="username" name="username" value="{{ username ?? '' }}" autocomplete="username" required autofocus>

        <label for="password">Wachtwoord</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>

        <button class="button full" type="submit">Inloggen</button>
    </form>
    <p class="form-note">Nog geen account? <a href="/register">Registreer hier</a>.</p>
</section>
{% endblock %}
