{% extends "partials/base.html.twig" %}

{% block title %}Start | Winkeltool{% endblock %}

{% block content %}
<section class="hero">
    <p class="eyebrow">Winkelbeheer</p>
    <h1>Van vakcapaciteit naar een duidelijk productieadvies.</h1>
    <p>Voer je winkelvoorraad in, bereken hoeveel eenheden je moet maken en stel een complete voedingswaardetekst samen.</p>
    <div class="actions">
        {% if user is defined and user %}
            <a class="button" href="/stock">Open voorraad</a>
            <a class="button secondary" href="/nutritional-values">Bereken voedingswaarden</a>
        {% else %}
            <a class="button" href="/login">Inloggen</a>
            <a class="button secondary" href="/register">Account maken</a>
        {% endif %}
    </div>
</section>

<section class="card-grid" aria-label="Functies">
    <article class="card">
        <h2>Winkelvoorraad</h2>
        <p>Bewaar producten met huidige voorraad, vakcapaciteit en standaard aantal per productieronde.</p>
    </article>
    <article class="card">
        <h2>Voedingswaarden</h2>
        <p>Bereken waarden per portie en kopieer direct een volledig voedingswaarde-etiket.</p>
    </article>
</section>
{% endblock %}
