generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int             @id @default(autoincrement())
  username       String          @unique
  passwordHash   String          @map("password")
  name           String?
  role           String          @default("user")
  sessions       Session[]
  stockMovements StockMovement[]

  @@map("users")
}

model Session {
  id         String   @id
  tokenHash  String   @unique @map("token_hash")
  userId     Int      @map("user_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("sessions")
}

model Product {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id          Int        @id @default(autoincrement())
  productId   Int        @map("product_id")
  weightGrams Int        @map("weight_grams")
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItem   StockItem?
  recipe      Recipe?

  @@unique([productId, weightGrams])
  @@index([productId])
  @@map("product_variants")
}

model StockItem {
  id               Int             @id @default(autoincrement())
  productVariantId Int             @unique @map("product_variant_id")
  currentStock     Int             @default(0) @map("current_stock")
  shelfCapacity    Int             @default(1) @map("shelf_capacity")
  unitsPerBatch    Int             @default(1) @map("units_per_batch")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  productVariant   ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  movements        StockMovement[]

  @@map("stock_items")
}

model StockMovement {
  id               Int       @id @default(autoincrement())
  stockItemId      Int       @map("stock_item_id")
  previousStock    Int       @map("previous_stock")
  newStock         Int       @map("new_stock")
  changeAmount     Int       @map("change_amount")
  note             String    @default("")
  recordedByUserId Int?      @map("recorded_by_user_id")
  recordedByName   String    @map("recorded_by_name")
  createdAt        DateTime  @default(now()) @map("created_at")
  stockItem        StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  recordedBy       User?     @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([stockItemId, createdAt])
  @@index([recordedByUserId])
  @@map("stock_movements")
}

model Ingredient {
  id            Int                @id @default(autoincrement())
  name          String             @unique
  fat           Float              @default(0)
  saturates     Float              @default(0)
  carbohydrates Float              @default(0)
  sugars        Float              @default(0)
  protein       Float              @default(0)
  salt          Float              @default(0)
  updatedAt     DateTime           @updatedAt @map("updated_at")
  recipeItems   RecipeIngredient[]

  @@map("ingredients")
}

model Recipe {
  id               Int                @id @default(autoincrement())
  productVariantId Int                @unique @map("product_variant_id")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  productVariant   ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  ingredients      RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id           Int        @id @default(autoincrement())
  recipeId     Int        @map("recipe_id")
  ingredientId Int        @map("ingredient_id")
  amountGrams  Float      @map("amount_grams")
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}
