{
	"name": "brassers",
	"private": true,
	"version": "1.0.0",
	"description": "Brassers winkelvoorraad, recepten en voedingswaarden in SvelteKit",
	"type": "module",
	"scripts": {
		"dev": "npm run db:prepare && vite dev",
		"build": "npm run db:generate && vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "prisma db seed",
		"db:prepare": "npm run db:generate && npm run db:deploy && npm run db:seed",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"validate": "npm run check && npm run lint && npm test && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prisma": "^7.10.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"argon2": "^0.45.1",
		"bcryptjs": "^3.0.3",
		"better-sqlite3": "^12.6.2",
		"dotenv": "^17.3.1",
		"exceljs": "^4.4.0",
		"zod": "^4.6.5"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"deepmerge-ts": "^8.0.0",
		"mysql2": "^3.23.1",
		"uuid": "^11.1.1"
	}
}
